digraph OLAP_Fact_Purchase {
    rankdir=LR;
    graph [
        splines=ortho,
        nodesep=1.5,
        ranksep=2.5,
        fontname="Arial",
        fontsize=14,
        label="Fact.Purchase - Star Schema Relationships\n(Partitioned by Date + Columnstore Index)",
        labelloc=t,
        pad=0.8
    ];
    node [
        shape=box,
        style="filled,rounded",
        fontname="Arial",
        fontsize=11,
        width=2.5,
        height=0.7
    ];
    edge [
        fontname="Arial",
        fontsize=10,
        color="#388E3C",
        penwidth=2.0,
        arrowsize=1.0
    ];

    // Dimension Tables
    DimDate [label="Dimension.Date\n(Calendar)", fillcolor="#BBDEFB"];
    DimEmployee [label="Dimension.Employee\n(Type 2 SCD)", fillcolor="#BBDEFB"];
    DimStockItem [label="Dimension.StockItem\n(Type 2 SCD)", fillcolor="#BBDEFB"];
    DimSupplier [label="Dimension.Supplier\n(Type 2 SCD)", fillcolor="#BBDEFB"];

    // Fact Table
    FactPurchase [label="Fact.Purchase\n(Partitioned by Date)", fillcolor="#C8E6C9", penwidth=2];

    // Relationships
    DimDate -> FactPurchase [taillabel="1", headlabel="N", labeldistance=2.5];
    DimEmployee -> FactPurchase [taillabel="1", headlabel="N", labeldistance=2.5];
    DimStockItem -> FactPurchase [taillabel="1", headlabel="N", labeldistance=2.5];
    DimSupplier -> FactPurchase [taillabel="1", headlabel="N", labeldistance=2.5];
}
