digraph OLAP_Fact_StockHolding {
    rankdir=LR;
    graph [
        splines=ortho,
        nodesep=1.5,
        ranksep=2.5,
        fontname="Arial",
        fontsize=14,
        label="Fact.StockHolding - Star Schema Relationships\n(Snapshot Fact Table)",
        labelloc=t,
        pad=0.8
    ];
    node [
        shape=box,
        style="filled,rounded",
        fontname="Arial",
        fontsize=11,
        width=2.5,
        height=0.7
    ];
    edge [
        fontname="Arial",
        fontsize=10,
        color="#00796B",
        penwidth=2.0,
        arrowsize=1.0
    ];

    // Dimension Tables
    DimDate [label="Dimension.Date\n(Calendar)", fillcolor="#BBDEFB"];
    DimEmployee [label="Dimension.Employee\n(Type 2 SCD)", fillcolor="#BBDEFB"];
    DimStockItem [label="Dimension.StockItem\n(Type 2 SCD)", fillcolor="#BBDEFB"];

    // Fact Table
    FactStockHolding [label="Fact.StockHolding\n(Snapshot)", fillcolor="#B2DFDB", penwidth=2];

    // Relationships
    DimDate -> FactStockHolding [taillabel="1", headlabel="N", labeldistance=2.5];
    DimEmployee -> FactStockHolding [taillabel="1", headlabel="N", labeldistance=2.5];
    DimStockItem -> FactStockHolding [taillabel="1", headlabel="N", labeldistance=2.5];
}
